# NexusDAG Backend Configuration
NEXUS_ENVIRONMENT=development
NEXUS_DATABASE_URL=postgresql+asyncpg://nexus:nexus@localhost:5432/nexusdag
NEXUS_LOG_LEVEL=INFO

# Embeddings: 'sentence-transformers' or 'hash'
NEXUS_EMBEDDING_PROVIDER=sentence-transformers
NEXUS_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# LLM: 'offline' or 'openai'
NEXUS_LLM_PROVIDER=offline
# NEXUS_LLM_API_KEY=sk-...
# NEXUS_LLM_MODEL=gpt-4o-mini
# NEXUS_LLM_BASE_URL=https://api.openai.com/v1

NEXUS_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
